# Preloads the esbuild compatibility shim for every npm script in this project.
#
# It exists so `npm run dev` / `npm run build` can start Vite in environments
# that block esbuild's child process (`spawn EPERM`). On a normal machine the
# shim forwards straight to native esbuild, so behaviour is unchanged.
#
# Keep the npm scripts themselves plain — this is the whole opt-in.
node-options=--require ./scripts/esbuild-loader.cjs
